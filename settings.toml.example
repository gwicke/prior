# settings.toml example

# --- Managed settings ---
# All optional; sensible built-in defaults are used when omitted. These are
# root-level keys, so they must appear before any `[table]` header below.
default_model = "anthropic:claude-3-5-sonnet-20241022"  # provider:model
security_mode = "confirm"          # yolo | confirm
tool_call_limit = 50
default_persona = "architect"      # built-in name or file path; omit for none
# Default reasoning level. Optional: omit it (or set "off" — the same thing)
# and no reasoning is requested. Was `default_thinking_level` before the
# /thinking -> /reasoning rename; the old key is migrated on load and dropped
# on the next save.
# default_reasoning_level = "high"  # off | low | med | high | max
show_reasoning = "content"         # disabled | indicator | content
reasoning_in_context = "never"     # always | never | aborted_turns_only
# llm_compact_prompt = "Summarize the conversation in less than 2000 words. Preserve the key documents, technical decisions, file paths, current task state, and any unresolved questions." 
# # prompt prepended to /tree <id> compact llm when no trailing text is given

# Custom agent prompt (replaces the default "Concise coding assistant" prompt)
# agent_prompt = "You are a senior software engineer specialized in Rust and systems programming."
# Or load from a file:
# agent_prompt_file = "prompts/custom_agent.txt"

# --- Per-model defaults ---
# One table per model, keyed by the same "provider:model" id as `default_model`.
# The key must be quoted: the colon is not legal in a bare TOML key.
#
# Two kinds of setting live here, and they do different things:
#
#   reasoning / temperature / top_p  are DEFAULTS for that model. They are
#     applied the first time you activate it in a session, and only if you have
#     not set the value yourself with /reasoning, /temperature or /top_p. A
#     runtime change is remembered for the session but is NOT written back here
#     unless you run `/model <id> save`, which copies your live values in.
#     A per-model default therefore beats `default_reasoning_level` above: once
#     a model's table exists, a later change to the global will not reach it.
#
#   context_length / *_cost / *_index / description  are DISPLAY overrides. They
#     change what the `/model` listing and `/stat` report for that model, and
#     nothing else — no provider is told about them.
#
# `Ctrl-E` on `/model <id> edit` edits exactly this table. It is the most direct
# way to set a value you would otherwise have to remember.
#
# Unknown keys are a startup error naming the key and suggesting the closest
# match, so a typo is loud rather than silently ignored.
#
# [models."anthropic:claude-3-5-sonnet-20241022"]
# reasoning = "high"          # off | low | med | high | max
# temperature = 0.2           # 0.0 - 2.0; omit to leave the provider's default
# top_p = 0.9                 # 0.0 - 1.0; omit to leave the provider's default
#
# [models."openrouter:stealth/space-bunny-alpha"]
# reasoning = "max"
# A display override, for a model the catalog describes poorly or not at all.
# The app uses this everywhere it shows the model's context window, including
# the status bar's context percentage — which is why it is worth setting when
# the published number is wrong.
# context_length = 1048576
# prompt_cost = 0.10
# completion_cost = 0.30

# Tool-specific configurations
[tool_config.bash]
# Commands that will be automatically allowed without prompting (when yolo is false)
auto_allow = [
  "^ls -la",
  "^git status",
  "^cargo test",
  "^npm test",
]
# Sandbox for the `bash` (and `agent-browser`) tools. Requires `bwrap`
# (bubblewrap) on PATH; prior fails closed at startup if it is absent. An
# unset sandbox config causes commands to be refused rather than run unsandboxed
# (there is no plain-shell fallback and no enable switch — the sandbox is
# always active when configured).
[tool_config.bash.sandbox]
# Wall-clock timeout for the whole command (seconds). 0 = no timeout.
timeout_secs = 120
# Maximum combined stdout+stderr (bytes) to retain from a single command.
# Output beyond this is truncated with a notice. Default 20480 (20 KiB).
# max_output_bytes = 20480
# Network egress policy (default false => no egress, network unshared).
#
# The sandbox is ALWAYS in its own network namespace, whatever this is set to.
# That is what keeps host-local services and the abstract X11 socket
# unreachable — not the allowlist. Egress, when enabled, goes through a SOCKS5
# bridge (the `prior-egress` shim, which must be installed alongside prior).
#
#   network = false   no egress; the network namespace is unshared.
#   network = true    PUBLIC destinations only, through the bridge; the sandbox
#                     keeps its own namespace. Local/private/link-local ranges
#                     (loopback, RFC 1918, cloud metadata, IPv6 ULA, multicast)
#                     are denied by default — they are host IPC, not egress.
#   [network]         optionally narrow or widen destinations on top of that.
#   enabled = true
#   allow = ["github.com:443", "*.crates.io:443"]
#
# An allowlist restricts *destinations*; it is not what makes `true` safe (the
# unshared netns is). An empty `allow` means any *public* destination. To reach a
# host-local service (a dev server, a DB on 127.0.0.1), name it explicitly, e.g.
# allow = ["127.0.0.1:5432"]; the check also runs on the resolved address, so a
# public name that rebinds to loopback is still refused. To permit nothing, use
# `false`.
#
# Operators that ignore the proxy variables (ALL_PROXY/HTTPS_PROXY/HTTP_PROXY)
# and open raw sockets get no egress; UDP is not carried (SOCKS5 CONNECT is
# TCP-only), though DNS works because names are resolved bridge-side.
network = false
# Virtual-memory cap in MB (default none).
# memory_mb = 1024
# PID isolation and capability drop (both default enabled).
# pid_isolation = true
# drop_caps = true
# Filesystem bindings. Bindings are split into two lists: `ro` for read-only
# mounts and `rw` for read-write mounts. Each entry is either a bare PATH
# (identical host/in-sandbox path) or a remap `{ from = "HOST", to = "SANDBOX" }`.
# When BOTH lists are empty the current directory is mounted read-only. Either
# way /tmp inside the sandbox is a per-session directory
# (`<app_config_dir>/sandbox-tmp/prior-<session-uuid>`, or a subdirectory of a
# `/tmp` remap below), so a command's scratch files persist across calls in the
# same session and are invisible to any other session. When either list is set,
# ONLY the listed paths are visible (deny by default) and the non-shell file
# tools enforce the same policy, so a remap like /tmp below is seen identically
# by the shell and by read/write.
rw = [
  ".",
  { from = "./cache", to = "/var/cache/app" },
]

ro = [
  # { from = "~/.cargo", to = "/opt/cargo" },
]

# Environment policy for the sandboxed command. bwrap inherits the parent env
# verbatim, so without this the LLM command could read host secrets (API keys,
# tokens, SSH agent socket) and host desktop session variables (DISPLAY,
# XAUTHORITY, DBUS_SESSION_BUS_ADDRESS). Two mutually-exclusive modes:
#   disallow  : keep the full env MINUS names matching `patterns`
#   only_allow: keep ONLY names matching `patterns` (everything else dropped)
# Patterns are glob (`*`/`?`) or literal, matched against var *names*.
#
# When `env` is omitted entirely, the built-in default is the allowlist shown
# below (with `LC_*` as a glob rather than spelled out). The sandbox also sets
# TMPDIR=/tmp itself (its own tmpfs). An explicit `env` block is authoritative
# in full: the built-in list and the forced TMPDIR are not mixed in.
#
# The block below is that default, ready to uncomment and amend. `LC_*` is
# expanded to the individual locale variables so it is obvious what is being
# granted; the built-in default matches them by glob. A whitelist must include
# PATH or commands break:
# [tool_config.bash.sandbox.env]
# mode = "only_allow"
# patterns = [
#   "PATH", "HOME", "TERM", "LANG",
#   "LC_ALL", "LC_CTYPE", "LC_NUMERIC", "LC_TIME", "LC_COLLATE",
#   "LC_MONETARY", "LC_MESSAGES", "LC_PAPER", "LC_NAME", "LC_ADDRESS",
#   "LC_TELEPHONE", "LC_MEASUREMENT", "LC_IDENTIFICATION",
#   "TZ", "USER", "LOGNAME", "SHELL",
#   "CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN",
#   "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME",
#   "XDG_STATE_HOME", "SOURCE_DATE_EPOCH",
# ]
# Or the older denylist behaviour (a denylist only removes the secret shapes
# it knows about; everything else, including DISPLAY, passes through):
# [tool_config.bash.sandbox.env]
# mode = "disallow"
# patterns = ["*_KEY", "*_SECRET", "*_TOKEN", "AWS_*", "SSH_AUTH_SOCK"]

# Named recipes for non-interactive execution (CI/CD, automation)
[recipes.review-security]
prompt = "Review the codebase for security issues and vulnerabilities. Exit with a clear summary and indicate if the build should break."
provider = "anthropic"
model = "claude-3-5-sonnet-20241022"
persona = "security"
yolo = false
# If the response matches this regex, exit with error (e.g. for CI/CD)
# error_if = "CRITICAL|FAIL|vulnerability found"

[recipes.simplify]
prompt = "Refactor the most complex functions in the current directory to be simpler and more readable. Maintain the same behavior."
yolo = true

[recipes.fix-lints]
prompt = "Run the project's linter and fix all reported issues."
yolo = true

[recipes.custom-review]
prompt_file = "prompts/review.txt"
model = "gpt-4o"
